    <item>
      <title>Blog</title>
      <link>http://localhost:1313/blog/</link>
      <pubDate>Thu, 07 Sep 2023 16:21:44 +0200</pubDate>
      <guid>http://localhost:1313/blog/</guid>
      <description>&lt;p&gt;Meet our team of passionate writers, researchers, and developers who share their knowledge and insights through our blog.&lt;/p&gt;&#xA;&lt;script&gt;&#xD;&#xA;function filterByTag(selectedTag) {&#xD;&#xA;  console.log(&#39;Selected tag:&#39;, selectedTag);&#xD;&#xA;&#xD;&#xA;  const blogCards = document.querySelectorAll(&#39;.card&#39;);&#xD;&#xA;  const allButtons = document.querySelectorAll(&#39;[data-tag]&#39;);&#xD;&#xA;&#xD;&#xA;  // 更新按钮状态&#xD;&#xA;  allButtons.forEach(btn =&gt; {&#xD;&#xA;    if (btn.getAttribute(&#39;data-tag&#39;) === selectedTag) {&#xD;&#xA;      btn.classList.remove(&#39;btn-outline-primary&#39;, &#39;btn-outline-secondary&#39;);&#xD;&#xA;      btn.classList.add(&#39;btn-primary&#39;);&#xD;&#xA;    } else {&#xD;&#xA;      btn.classList.remove(&#39;btn-primary&#39;);&#xD;&#xA;      if (btn.getAttribute(&#39;data-tag&#39;) === &#39;all&#39;) {&#xD;&#xA;        btn.classList.add(&#39;btn-outline-primary&#39;);&#xD;&#xA;      } else {&#xD;&#xA;        btn.classList.add(&#39;btn-outline-secondary&#39;);&#xD;&#xA;      }&#xD;&#xA;    }&#xD;&#xA;  });&#xD;&#xA;&#xD;&#xA;  // 过滤博客文章&#xD;&#xA;  blogCards.forEach(card =&gt; {&#xD;&#xA;    if (selectedTag === &#39;all&#39;) {&#xD;&#xA;      card.style.display = &#39;block&#39;;&#xD;&#xA;      card.style.opacity = &#39;1&#39;;&#xD;&#xA;      card.style.transform = &#39;scale(1)&#39;;&#xD;&#xA;    } else {&#xD;&#xA;      // 检查文章是否包含选中的标签&#xD;&#xA;      const cardText = card.textContent.toLowerCase();&#xD;&#xA;      if (cardText.includes(selectedTag.toLowerCase())) {&#xD;&#xA;        card.style.display = &#39;block&#39;;&#xD;&#xA;        card.style.opacity = &#39;1&#39;;&#xD;&#xA;        card.style.transform = &#39;scale(1)&#39;;&#xD;&#xA;      } else {&#xD;&#xA;        card.style.opacity = &#39;0&#39;;&#xD;&#xA;        card.style.transform = &#39;scale(0.95)&#39;;&#xD;&#xA;        setTimeout(() =&gt; {&#xD;&#xA;          card.style.display = &#39;none&#39;;&#xD;&#xA;        }, 300);&#xD;&#xA;      }&#xD;&#xA;    }&#xD;&#xA;  });&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// 页面加载完成后初始化&#xD;&#xA;document.addEventListener(&#39;DOMContentLoaded&#39;, function() {&#xD;&#xA;  console.log(&#39;Tag filter initialized&#39;);&#xD;&#xA;  console.log(&#39;Blog cards found:&#39;, document.querySelectorAll(&#39;.card&#39;).length);&#xD;&#xA;});&#xD;&#xA;&lt;/script&gt;</description>
    </item>
